{
    "name": "aliifz/kissflow-php",
    "description": "Framework-agnostic PHP client for the Kissflow REST API (process, dataset and user endpoints), with optional Laravel integration.",
    "type": "library",
    "license": "MIT",
    "keywords": ["kissflow", "api", "client", "dataset", "workflow", "laravel"],
    "authors": [
        { "name": "aliifz" }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.5",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "suggest": {
        "illuminate/support": "For the Laravel service provider and facade (auto-discovered)."
    },
    "autoload": {
        "psr-4": {
            "Aliifz\\Kissflow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aliifz\\Kissflow\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aliifz\\Kissflow\\Laravel\\KissflowServiceProvider"
            ],
            "aliases": {
                "Kissflow": "Aliifz\\Kissflow\\Laravel\\Kissflow"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
